# Placeholders only. Supply private local values in .env before Docker Compose.
APP_ENV=development
HTTP_ADDR=:8080
HTTP_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
CORS_ORIGINS=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sa_lathe_shop
DB_USER=sa_lathe_shop
DB_PASSWORD=
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=10
DB_PING_TIMEOUT=3s
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sa-lathe-shop-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true
