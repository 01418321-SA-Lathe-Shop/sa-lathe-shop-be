# Placeholders only. Supply private local values in .env before Docker Compose.
APP_ENV=development
# Demo seeding is OFF and never reads this file automatically. Use private
# process environment and scripts/seed-demo.ps1; see docs/015-demo-seed.md.
# No fallback to DATABASE_URL/DB_* is permitted.
SEED_ENABLED=false
SEED_ENV=
SEED_DATABASE_URL=
SEED_CONFIRM_DATABASE=
SEED_API_BASE_URL=
SEED_PIM_PASSWORD=
SEED_ANAN_PASSWORD=
SEED_KITTIPONG_PASSWORD=
SEED_NIDA_PASSWORD=
SEED_PLOY_PASSWORD=
SEED_SOMCHAI_PASSWORD=
HTTP_ADDR=:8080
API_PORT=8080
HTTP_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
CORS_ORIGINS=http://localhost:3000
AUTH_SESSION_TTL=12h
DB_HOST=localhost
DB_PORT=55432
DB_NAME=sa_lathe_shop
DB_USER=sa_lathe_shop
DB_PASSWORD=
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=10
DB_PING_TIMEOUT=3s
S3_ENDPOINT=http://localhost:19000
# Browser-reachable origin for signed links; do not use Docker's internal hostname.
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_PORT=19000
S3_REGION=us-east-1
S3_BUCKET=sa-lathe-shop-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true

# Disabled by default. Set a LINE Messaging API channel token and the specific
# Admin's LINE user ID privately. Never use a group/broadcast recipient.
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
